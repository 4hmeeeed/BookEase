APP_NAME=BookEase
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bookease
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Booking rules (config/bookease.php)
BOOKEASE_CHECK_IN_TIME=14:00
BOOKEASE_CHECK_OUT_TIME=12:00
BOOKEASE_MAX_NIGHTS=30
BOOKEASE_BOOKING_WINDOW_DAYS=365
# Unconfirmed reservation requests one guest may have waiting at once.
BOOKEASE_MAX_PENDING_PER_GUEST=3

# Payments: "fake" = built-in sandbox checkout (no account needed), "paymongo" = PayMongo test mode.
PAYMENT_DRIVER=fake
# Down payment share of the total (resort policy, confirm with the owner).
BOOKEASE_DOWN_PAYMENT_PERCENT=50
PAYMENT_WEBHOOK_TOLERANCE=300
# Keep false until the owner explicitly moves payments to live.
PAYMENT_ALLOW_LIVE_MODE=false
PAYMONGO_SECRET_KEY=sk_test_
PAYMONGO_WEBHOOK_SECRET=whsk_

# Inquiry chatbot (Google Gemini). Without a key, guests get a fixed "contact the resort" reply.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the model above is overloaded, times out or is retired (comma-separated).
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Seconds per model attempt, and for all attempts together.
GEMINI_TIMEOUT=20
GEMINI_TOTAL_TIMEOUT=40
CHATBOT_ENABLED=true
CHATBOT_PER_MINUTE=10
CHATBOT_PER_DAY=150

# Resort contact details used by the chatbot. Leave blank rather than guessing.
RESORT_CONTACT_PHONE=
RESORT_CONTACT_EMAIL=
RESORT_CONTACT_FACEBOOK=

# "Continue with Google" on the guest sign-in (free OAuth client from Google Cloud Console).
# Leave blank to hide the button. Authorised redirect URI: APP_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback

# Brevo HTTPS mail (MAIL_MAILER=brevo)
BREVO_API_KEY=

# GCash/Maya to the resort's own wallet (used when PAYMENT_DRIVER=none)
GCASH_NUMBER=
GCASH_ACCOUNT_NAME=
MAYA_NUMBER=
MAYA_ACCOUNT_NAME=
