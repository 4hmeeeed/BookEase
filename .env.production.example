# BookEase production settings for InfinityFree (labnasanresort.com).
# Copy this file to htdocs/.env on the server and fill in every line marked FILL IN.
# Never commit the filled-in copy: it holds passwords and keys.

APP_NAME=BookEase
APP_ENV=production
# FILL IN: run `php artisan key:generate --show` on your laptop and paste the result (starts with base64:).
APP_KEY=
APP_DEBUG=false
APP_URL=https://labnasanresort.com
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Errors only, one log file per day, kept 14 days (storage/logs).
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# FILL IN from InfinityFree: Control panel > MySQL Databases.
# The host is NOT localhost; it looks like sqlNNN.infinityfree.com.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions and cache in the database, so "sign out everywhere" really ends other sessions.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No background workers on InfinityFree: everything runs immediately.
QUEUE_CONNECTION=sync

# Email through an outside SMTP service (InfinityFree has no mail server).
# Gmail: smtp.gmail.com, port 587, your full Gmail address and a 16-letter app password.
# Brevo: smtp-relay.brevo.com, port 587, your Brevo SMTP login and SMTP key.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# FILL IN
MAIL_USERNAME=
# FILL IN (an app password or SMTP key, not your normal login password)
MAIL_PASSWORD=
# FILL IN: the address guests see; for Gmail it must be the same Gmail address.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Labnasan Resort"

VITE_APP_NAME="${APP_NAME}"

# Booking rules (config/bookease.php). Confirm with the owner.
BOOKEASE_CHECK_IN_TIME=14:00
BOOKEASE_CHECK_OUT_TIME=12:00
BOOKEASE_MAX_NIGHTS=30
BOOKEASE_BOOKING_WINDOW_DAYS=365
BOOKEASE_MAX_PENDING_PER_GUEST=3

# Pay at the resort: InfinityFree blocks the payment gateway's webhooks, so online
# GCash/Maya stays off and staff record payments at the front desk.
PAYMENT_DRIVER=none
BOOKEASE_DOWN_PAYMENT_PERCENT=50
PAYMENT_ALLOW_LIVE_MODE=false

# Hosting without cron: run the daily clean-up from the first visit of each day.
BOOKEASE_CLEANUP_ON_REQUESTS=true
# How often an open staff/owner console asks for new alerts (InfinityFree has a daily hit limit).
BOOKEASE_BELL_POLL_SECONDS=90

# Leave empty at first. If the owner's System page shows the host's proxy address
# instead of your own, set TRUSTED_PROXIES=* so rate limits apply per visitor.
TRUSTED_PROXIES=

# Inquiry chatbot (Google Gemini). FILL IN the API key (aistudio.google.com).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Hand over to the backup model quickly; InfinityFree stops PHP after about a minute.
GEMINI_TIMEOUT=10
GEMINI_TOTAL_TIMEOUT=30
CHATBOT_ENABLED=true
CHATBOT_PER_MINUTE=10
CHATBOT_PER_DAY=150

# FILL IN with the resort's real details (the chatbot quotes them). Leave blank rather than guessing.
RESORT_CONTACT_PHONE=
RESORT_CONTACT_EMAIL=
RESORT_CONTACT_FACEBOOK=

# "Continue with Google" (guests only). FILL IN from Google Cloud Console > Credentials.
# Authorised redirect URI there: https://labnasanresort.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback
